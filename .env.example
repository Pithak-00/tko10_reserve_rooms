# ============================================================
# .env.example — このファイルをコピーして .env を作成してください
# cp .env.example .env
# ============================================================
# ⚠️ .env には実際の認証情報を記載します。絶対にコミットしないでください。
# ⚠️ .env は .gitignore に登録済みです。

# ── Django 基本設定 ───────────────────────────────────────
DEBUG=true
SECRET_KEY=local-dev-secret-key-change-this
ALLOWED_HOSTS=*

# ── Google OAuth 2.0（個人カレンダー同期用） ─────────────
# Google Cloud Console → 「APIとサービス」→「認証情報」で取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 本番URLに合わせて変更してください
GOOGLE_REDIRECT_URI=http://localhost/reservations/auth/google/callback/

# ── Rakumo連携: サービスアカウント認証（ドメイン全体委任） ──
# credentials/service_account.json を配置すれば下記は省略可（デフォルト値あり）
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ドメイン全体委任を許可した Google Workspace 管理者メールアドレス
GOOGLE_DELEGATED_ADMIN=your-admin@yourdomain.com
